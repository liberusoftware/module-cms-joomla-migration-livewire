{
  "description": "Livewire adapter for Joomla Migration.",
  "require": {
    "liberusoftware/module-cms-migration-framework": "^0.1",
    "liberusoftware/module-cms-joomla-migration": "^0.1",
    "php": "^8.5",
    "livewire/livewire": "^4.4.8"
  },
  "name": "liberusoftware/module-cms-joomla-migration-livewire",
  "version": "0.1.0",
  "extra": {
    "liberu": {
      "name": "module-cms-joomla-migration-livewire",
      "core": "liberusoftware/module-cms-joomla-migration"
    },
    "laravel": {
      "providers": [
